export type ProjectType =
  | "typescript"
  | "python"
  | "go"
  | "rust";

export interface ProjectConfig {
  name: string;
  description: string;
  type: ProjectType;
  author: string;
  license: "MIT" | "Apache-2.0";
  private: boolean;
  dryRun: boolean;
}

export const supportedTypes: ProjectType[] = [
  "typescript",
  "python",
  "go",
  "rust"
];

export function validateProjectName(name: string): void {
  if (!name) {
    throw new Error("Project name is required.");
  }

  if (!/^[a-z0-9][a-z0-9-_]*$/.test(name)) {
    throw new Error(
      "Project name must contain only lowercase letters, numbers, hyphens, and underscores."
    );
  }

  if (name.length > 64) {
    throw new Error("Project name cannot exceed 64 characters.");
  }
}

export function validateProjectType(type: string): asserts type is ProjectType {
  if (!supportedTypes.includes(type as ProjectType)) {
    throw new Error(
      `Unsupported project type "${type}". Supported types: ${supportedTypes.join(", ")}`
    );
  }
}



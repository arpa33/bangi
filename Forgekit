#!/usr/bin/env node

import { Command } from "commander";

import {
  validateProjectName,
  validateProjectType,
  supportedTypes,
  type ProjectType,
  type ProjectConfig
} from "./config.js";

import { generateRepository } from "./generator.js";

const program = new Command();

program
  .name("forgekit")
  .description(
    "Generate production-ready GitHub repositories from the command line."
  )
  .version("1.0.0");

program
  .command("create")
  .description("Create a new GitHub repository structure")
  .argument("<name>", "repository name")
  .option(
    "-t, --type <type>",
    `project type (${supportedTypes.join(", ")})`,
    "typescript"
  )
  .option(
    "-d, --description <description>",
    "project description",
    "A production-ready software project."
  )
  .option("-a, --author <author>", "author name", "Contributors")
  .option(
    "-l, --license <license>",
    "license type (MIT, Apache-2.0)",
    "MIT"
  )
  .option("--private", "mark repository as private")
  .option("--dry-run", "validate configuration without creating files")
  .action(
    async (
      name: string,
      options: {
        type: string;
        description: string;
        author: string;
        license: string;
        private?: boolean;
        dryRun?: boolean;
      }
    ) => {
      try {
        validateProjectName(name);
        validateProjectType(options.type);

        if (
          options.license !== "MIT" &&
          options.license !== "Apache-2.0"
        ) {
          throw new Error(
            'License must be either "MIT" or "Apache-2.0".'
          );
        }

        const config: ProjectConfig = {
          name,
          description: options.description,
          type: options.type as ProjectType,
          author: options.author,
          license: options.license as "MIT" | "Apache-2.0",
          private: Boolean(options.private),
          dryRun: Boolean(options.dryRun)
        };

        if (config.dryRun) {
          console.log("");
          console.log("Configuration valid.");
          console.log("");
          console.log(JSON.stringify(config, null, 2));
          console.log("");
          return;
        }

        await generateRepository(config);
      } catch (error) {
        console.error(
          `\nError: ${
            error instanceof Error ? error.message : "Unknown error"
          }\n`
        );

        process.exitCode = 1;
      }
    }
  );

program
  .command("info")
  .description("Display Forgekit information")
  .action(() => {
    console.log(`
Forgekit
--------

Professional GitHub repository scaffolding CLI.

Supported project types:
${supportedTypes.map((type) => `  • ${type}`).join("\n")}

Example:
  forgekit create my-project --type typescript
`);
  });

program.parseAsync(process.argv);



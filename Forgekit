import path from "node:path";
import fs from "node:fs/promises";

import type { ProjectConfig } from "./config.js";
import { pathExists, writeFile } from "./utils.js";

import {
  readmeTemplate,
  gitignoreTemplate,
  contributingTemplate,
  securityTemplate,
  changelogTemplate,
  bugTemplate,
  featureTemplate,
  pullRequestTemplate,
  ciTemplate
} from "./templates.js";

export async function generateRepository(
  config: ProjectConfig
): Promise<void> {
  const root = path.resolve(process.cwd(), config.name);

  if (await pathExists(root)) {
    throw new Error(
      `Directory "${config.name}" already exists. Choose another name.`
    );
  }

  const files: Record<string, string> = {
    "README.md": readmeTemplate(config),
    ".gitignore": gitignoreTemplate(config.type),
    "CONTRIBUTING.md": contributingTemplate(config),
    "SECURITY.md": securityTemplate(),
    "CHANGELOG.md": changelogTemplate(),

    ".github/workflows/ci.yml": ciTemplate(config.type),

    ".github/ISSUE_TEMPLATE/bug_report.md": bugTemplate(),

    ".github/ISSUE_TEMPLATE/feature_request.md": featureTemplate(),

    ".github/pull_request_template.md": pullRequestTemplate(),

    "src/.gitkeep": ""
  };

  if (config.type === "typescript") {
    files["package.json"] = JSON.stringify(
      {
        name: config.name,
        version: "1.0.0",
        private: config.private,
        type: "module",
        scripts: {
          build: "tsc",
          typecheck: "tsc --noEmit"
        }
      },
      null,
      2
    ) + "\n";

    files["tsconfig.json"] = JSON.stringify(
      {
        compilerOptions: {
          target: "ES2022",
          module: "NodeNext",
          moduleResolution: "NodeNext",
          strict: true,
          outDir: "dist"
        },
        include: ["src/**/*.ts"]
      },
      null,
      2
    ) + "\n";

    files["src/index.ts"] = `export function main(): void {
  console.log("${config.name} is ready.");
}

main();
`;
  }

  if (config.type === "python") {
    files["pyproject.toml"] = `[project]
name = "${config.name}"
version = "1.0.0"
description = "${config.description}"
requires-python = ">=3.11"
`;

    files["src/main.py"] = `def main() -> None:
    print("${config.name} is ready.")


if __name__ == "__main__":
    main()
`;
  }

  if (config.type === "go") {
    files["go.mod"] = `module ${config.name}

go 1.23
`;

    files["main.go"] = `package main

import "fmt"

func main() {
    fmt.Println("${config.name} is ready.")
}
`;
  }

  if (config.type === "rust") {
    files["Cargo.toml"] = `[package]
name = "${config.name}"
version = "1.0.0"
edition = "2021"

[dependencies]
`;

    files["src/main.rs"] = `fn main() {
    println!("${config.name} is ready.");
}
`;
  }

  for (const [file, content] of Object.entries(files)) {
    await writeFile(path.join(root, file), content);
  }

  await fs.writeFile(
    path.join(root, ".forgekit.json"),
    JSON.stringify(config, null, 2) + "\n",
    "utf8"
  );

  console.log("");
  console.log(`✓ Repository created: ${root}`);
  console.log("");
  console.log("Next steps:");
  console.log(`  cd ${config.name}`);

  if (config.type === "typescript") {
    console.log("  npm install");
  }

  console.log("  git init");
  console.log("  git add .");
  console.log('  git commit -m "chore: initialize repository"');
  console.log("");
}



import { RepositoryManager } from "./repository";
import { ProjectAnalyzer } from "./analyzer";

const project = new RepositoryManager(
  "NexaForge",
  "A smart GitHub repository management tool"
);

project.create();

const analyzer = new ProjectAnalyzer(project.name);

analyzer.scan();

console.log("NexaForge is ready 🚀");
export class RepositoryManager {
  name: string;
  description: string;

  constructor(name: string, description: string) {
    this.name = name;
    this.description = description;
  }

  create(): void {
    console.log(`Repository created: ${this.name}`);
    console.log(`Description: ${this.description}`);
  }
}
export class ProjectAnalyzer {
  private repositoryName: string;

  constructor(repositoryName: string) {
    this.repositoryName = repositoryName;
  }

  scan(): void {
    console.log(
      `Analyzing repository ${this.repositoryName}...`
    );

    console.log("Checking files...");
    console.log("Checking dependencies...");
    console.log("Analysis completed successfully ✅");
  }
}
